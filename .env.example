# Copy this file to .env and fill in your own values. Never commit .env.

# Token from @BotFather (looks like 123456789:AA...). Placeholder below is NOT a real token.
BOT_TOKEN=123456789:replace-with-your-token-from-BotFather

# Signs every QR entry pass. A random string of 32+ characters, kept secret. Make one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Changing it later makes every QR pass issued so far invalid.
QR_SECRET=replace-with-a-long-random-secret

# Public HTTPS address of this server, without a trailing slash (for example a free cloudflared tunnel).
# Invitation links become https://<address>/i/<link>, the Mini App https://<address>/webapp/.
# Leave empty to run the bot only (links are then bot deep links).
PUBLIC_URL=

# Telegram user ids of admins (comma separated). Admins can close a wedding. Find yours with @userinfobot.
ADMIN_IDS=

# Where the SQLite file lives (the folder is created automatically).
DB_PATH=data/toytaklif.db
# Fill an empty database with the fictional demo wedding (80 invites, 25 days from today). 0 = start empty.
SEED_DEMO=1

# Web server for the invitation pages, the Mini App and their APIs.
HOST=0.0.0.0
PORT=8080

# Mini App login data older than this many seconds is refused.
INITDATA_MAX_AGE=3600
# Bot buttons and Mini App calls per user per minute.
RATE_PER_MINUTE=30
# Invitation page requests per IP address per minute.
PUBLIC_RATE_PER_MINUTE=40
# Set to 1 only behind a reverse proxy you control (then X-Forwarded-For is used for the per-IP limit).
TRUST_PROXY=0
LOG_LEVEL=INFO
